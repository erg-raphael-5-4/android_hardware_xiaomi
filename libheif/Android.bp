// libheif, as it was in frameworks/av before Android 17 removed it
// (frameworks/av baa3574157 "Remove libheif source directory": the platform
// now decodes HEIC through CrabbyAvif). The Xiaomi Miracast blob
// libwfdcommonutils.so still has a DT_NEEDED on libheif.so, so the library is
// kept here, unchanged from frameworks/av d92cfd6a29 (lineage-23.2), purely to
// satisfy that link. Nothing else in the tree uses it.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_shared {
    name: "libheif",

    srcs: [
        "HeifDecoderImpl.cpp",
    ],

    shared_libs: [
        "libbinder",
        "liblog",
        "libutils",
        "libmedia",
    ],

    cflags: [
        "-Werror",
        "-Wall",
    ],

    export_include_dirs: ["include"],
}
